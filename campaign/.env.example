# ── AToure CRM ────────────────────────────────────────────────────────────────
# URL of your deployed CRM backend (Railway, Render, etc.)
CRM_URL=https://your-crm.up.railway.app

# Access code for the CRM (set in your CRM's ACCESS_CODE env var — default is 280601)
CRM_ACCESS_CODE=280601

# ── IONOS email ───────────────────────────────────────────────────────────────
# The IONOS address you send FROM
IONOS_EMAIL=hello@atoureconsulting.com
IONOS_PASSWORD=your_ionos_email_password

# IONOS SMTP host — use smtp.ionos.co.uk (UK) or smtp.ionos.com (EU/US)
IONOS_SMTP_HOST=smtp.ionos.co.uk

# Display name shown in the From field
FROM_NAME=Aminata Touré | AToure Consulting

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# Used to write a personalised email for each contact
# Get your API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────
# Delay in ms between each email (default: 4000 = 4s). Keeps you within IONOS limits.
EMAIL_DELAY_MS=4000
